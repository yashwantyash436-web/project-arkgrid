# Application
ARKGRID_ENV=
ARKGRID_LOG_LEVEL=
ARKGRID_API_BASE_URL=

# Database (use a local SQLite URL during the first development phase)
DATABASE_URL=sqlite:///./services/api/arkgrid.sqlite3
ARKGRID_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ARKGRID_COORDINATOR_TOKEN=

# External data providers — configure only when that integration starts
USGS_EARTHQUAKE_FEED_URL=
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
COPERNICUS_TOKEN_URL=

# Optional services to decide on later
GEOCODING_BASE_URL=
SMS_PROVIDER_API_KEY=
ERROR_TRACKING_DSN=
